# This project has NO build step and NO server, so nothing reads a .env file at runtime.
# This file only documents the values you need and where they go.
#
# 1) Firebase WEB app config  ->  paste into firebase-config.js (firebaseConfig = { ... })
#    These are public identifiers, not secrets. Security comes from firestore.rules + Firebase Auth.
FIREBASE_API_KEY=            # Firebase console > Project settings > Your apps > Web app > apiKey
FIREBASE_AUTH_DOMAIN=        # <project-id>.firebaseapp.com
FIREBASE_PROJECT_ID=         # your Firebase project id
FIREBASE_APP_ID=             # web app id (1:123456789:web:abc...)
#
# 2) First admin (done in the Firebase console, nothing to put in code)
ADMIN_USER_UID=              # Authentication > Users > copy "User UID", then create Firestore doc admins/<UID>
#
# NEVER commit: service-account JSON files, private keys, or user passwords.
# No secret is required anywhere in this project.
