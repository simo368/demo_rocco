rules_version = '2';

// Authorization lives HERE (server side). The browser code is never trusted.
// Admins are users whose UID has a document in /admins/{uid}. That collection can only be edited
// from the Firebase console (or Admin SDK), never from the website.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function text(v, max) { return v is string && v.size() <= max; }

    // ----- admins: a user may only check their own entry -----
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }

    // ----- site content: published is public, draft is admin-only -----
    function validSite(d) {
      return d.keys().hasOnly(['brand', 'seo', 'nav', 'sections', 'hero', 'productsSection', 'about', 'updates', 'join', 'footer', 'appearance', 'updatedAt'])
        && d.brand.name is string && d.brand.name.size() > 0 && d.brand.name.size() <= 60
        && text(d.seo.title, 70) && text(d.seo.description, 170)
        && d.nav is list && d.nav.size() <= 12
        && d.sections is list && d.sections.size() <= 4
        && d.hero.title is string && d.hero.title.size() > 0 && d.hero.title.size() <= 80
        && text(d.hero.image, 200)
        && text(d.about.body, 3000)
        && d.updates.announcements is list && d.updates.announcements.size() <= 20
        && d.join.enabled is bool && text(d.join.consentText, 300) && text(d.join.privacyUrl, 300)
        && d.footer.social is list && d.footer.social.size() <= 8
        && d.appearance.textScale is number && d.appearance.textScale >= 0.9 && d.appearance.textScale <= 1.15
        && d.appearance.contentWidth is number && d.appearance.contentWidth >= 1100 && d.appearance.contentWidth <= 1680
        && d.appearance.density is number && d.appearance.density >= 0.8 && d.appearance.density <= 1.3
        && d.appearance.motion is number && d.appearance.motion >= 0 && d.appearance.motion <= 1
        && d.appearance.paper.matches('^#[0-9a-fA-F]{6}$') && d.appearance.ink.matches('^#[0-9a-fA-F]{6}$')
        && d.appearance.muted.matches('^#[0-9a-fA-F]{6}$') && d.appearance.surface.matches('^#[0-9a-fA-F]{6}$');
    }
    match /site/published {
      allow read: if true;
      allow write: if isAdmin() && validSite(request.resource.data);
    }
    match /site/draft {
      allow read: if isAdmin();
      allow write: if isAdmin() && validSite(request.resource.data);
    }

    // ----- products: only "published" ones are readable by visitors -----
    function validProduct(d) {
      return d.keys().hasOnly(['name', 'slug', 'description', 'images', 'focal', 'price', 'currency', 'availability', 'status', 'sortOrder', 'createdAt', 'updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.slug is string && d.slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$') && d.slug.size() <= 80
        && text(d.description, 2000)
        && d.images is list && d.images.size() <= 10
        && (d.price == null || (d.price is number && d.price >= 0 && d.price <= 1000000))
        && d.currency in ['EUR', 'USD', 'GBP', 'CHF']
        && d.availability in ['coming-soon', 'available', 'unavailable']
        && d.status in ['draft', 'published', 'archived']
        && d.sortOrder is number;
    }
    match /products/{id} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create, update: if isAdmin() && validProduct(request.resource.data);
      allow delete: if isAdmin();
    }

    // ----- media: metadata+thumbnail for admins, full image readable by id (no listing) -----
    match /media/{id} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'type', 'size', 'width', 'height', 'thumb', 'createdAt', 'updatedAt'])
        && text(request.resource.data.name, 100) && text(request.resource.data.thumb, 100000)
        && request.resource.data.type in ['image/jpeg', 'image/webp'];
    }
    match /mediaData/{id} {
      allow get: if true;
      allow list: if isAdmin();
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['data', 'type'])
        && request.resource.data.data is string && request.resource.data.data.size() <= 900000
        && request.resource.data.data.matches('^data:image/(jpeg|webp);base64,.*');
    }

    // ----- sign-ups: anyone may create a valid entry; only admins can read or delete -----
    match /signups/{id} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'consent', 'consentText', 'source', 'createdAt'])
        && request.resource.data.email is string && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.consent == true
        && text(request.resource.data.consentText, 300)
        && request.resource.data.source == 'website'
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
